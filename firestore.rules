rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /movies/{movieId} {
      allow read: if request.auth != null;
      allow delete: if request.auth != null && request.auth.token.admin == true;
      allow create: if request.auth != null && request.auth.token.admin == true
        && request.resource.data.keys().hasAll(['title','year','director','genre','synopsis','image'])
        && request.resource.data.keys().hasOnly(['title','year','director','genre','synopsis','image'])
        && request.resource.data.title is string
        && request.resource.data.year is int
        && request.resource.data.year >= 1000 && request.resource.data.year <= 9999
        && request.resource.data.director is string
        && request.resource.data.genre is string
        && request.resource.data.synopsis is string
        && request.resource.data.image is string
        && request.resource.data.image.matches('https://.+');
    }
  }
}
